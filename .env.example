# ==========================================
# LINE Bot 與 Google Gemini 環境變數設定
# 請將此檔案複製為 .env 並填入實際的金鑰
# ==========================================

# 1. LINE Developers Console 設定
# 前往: https://developers.line.biz/console/
# 在您的 Messaging API Channel 找到對應資訊：
# - Basic settings 分頁 -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# - Messaging API 分頁 -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 2. Google Gemini API Key
# 前往: https://aistudio.google.com/ 點擊 "Get API key" 免費取得
GEMINI_API_KEY=your_gemini_api_key_here

# 網路搜尋預設關閉，避免 grounding 費用；課堂專案建議維持 false
GEMINI_WEB_SEARCH=false

# 3. 伺服器埠號 (本地測試預設 5000)
PORT=5000
